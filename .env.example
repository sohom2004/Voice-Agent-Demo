# Gemini API (chat, embeddings, Gemini Live voice)
# LiveKit Google plugin also accepts GOOGLE_API_KEY; GEMINI_API_KEY is mapped automatically.
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# Platform PostgreSQL (documents + RAG)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="postgres"

# sql-mcp target database (defaults to bundled medical-billing SQLite demo)
SQL_MCP_DIALECT="sqlite"
SQL_MCP_DATABASE="demo_database.db"
SQL_MCP_HOST="localhost"
SQL_MCP_PORT="5432"
SQL_MCP_USER="postgres"
SQL_MCP_PASSWORD="postgres"

# LiveKit (voice agent)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# App URL (optional)
APP_URL="http://localhost:3000"

# Gmail API (optional — voice email tools + /api/email/*)
# Leave empty to disable sending; agent returns a clean error instead of crashing.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""
