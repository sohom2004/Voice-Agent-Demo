# Gemini API (chat, TTS, voice agent LLM)
GEMINI_API_KEY=""

# Platform PostgreSQL (documents + RAG)
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="postgres"

# sql-mcp target database (defaults to bundled SQLite demo)
SQL_MCP_DIALECT="sqlite"
SQL_MCP_DATABASE="demo_database.db"
SQL_MCP_HOST="localhost"
SQL_MCP_PORT="5432"
SQL_MCP_USER="postgres"
SQL_MCP_PASSWORD="postgres"

# LiveKit (voice agent)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# App URL (optional)
APP_URL="http://localhost:3000"
