# Gemini API (chat, embeddings, Gemini Live voice)
# LiveKit Google plugin also accepts GOOGLE_API_KEY; GEMINI_API_KEY is mapped automatically.
GEMINI_API_KEY=""
GOOGLE_API_KEY=""

# -----------------------------------------------------------------------------
# PostgreSQL — used for BOTH document/RAG (public schema) and SQL-MCP (business)
# Local development and Render production share this variable name.
# On Render, set DATABASE_URL to the *internal* connection string.
# -----------------------------------------------------------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/voice_agent"

# Optional discrete overrides if DATABASE_URL is not set
PGHOST="localhost"
PGPORT="5432"
PGUSER="postgres"
PGPASSWORD=""
PGDATABASE="voice_agent"

# SQL-MCP (production + local default: PostgreSQL business schema)
SQL_MCP_DIALECT="postgresql"
SQL_MCP_SCHEMA="business"
# Optional SQL-MCP-only URL; defaults to DATABASE_URL
SQL_MCP_DATABASE_URL=""
SQL_MCP_HOST="localhost"
SQL_MCP_PORT="5432"
SQL_MCP_USER="postgres"
SQL_MCP_PASSWORD=""
SQL_MCP_DATABASE="voice_agent"
SQL_MCP_TENANT_ID="default_tenant"

# Development-only: force SQL-MCP onto the original SQLite seed file.
# Do not set these in production (RENDER / APP_ENV=production will refuse SQLite).
# SQL_MCP_DIALECT="sqlite"
# SQL_MCP_DATABASE="demo_database.db"

APP_ENV="development"

# LiveKit (voice agent)
LIVEKIT_URL=""
LIVEKIT_API_KEY=""
LIVEKIT_API_SECRET=""

# App URL (optional)
APP_URL="http://localhost:3000"

# Gmail API (optional — voice email tools + /api/email/*)
# Leave empty to disable sending; agent returns a clean error instead of crashing.
GMAIL_CLIENT_ID=""
GMAIL_CLIENT_SECRET=""
GMAIL_REFRESH_TOKEN=""
GMAIL_USER_EMAIL=""
GMAIL_REDIRECT_URI="http://localhost:8000/auth/google/callback"
